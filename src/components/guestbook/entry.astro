
---
import type { GuestbookEntry } from "@/lib/guestbook/types";
import { normalizeUrl, formatDate } from "@/lib/guestbook/format/";
import EntryContent from "./entryContent.astro";

interface Props {
  entry: GuestbookEntry;
}

const { entry } = Astro.props as Props;
const { ID, CreatedAt, Name, Website, Message } = entry;

const { date, time } = formatDate(CreatedAt);
const safeWebsite = Website ? normalizeUrl(Website) : null;
---

<article class="entry-box" id={`entry-${ID}`}>
  <header class="entry-header">

    <div class="entry-author">
      <strong class="importantshit">{Name}</strong>

      {safeWebsite && (
        <span class="website">
          desde{" "}
          <a
            href={safeWebsite}
            target="_blank"
            rel="noopener noreferrer"
          >
            {Website}
          </a>
        </span>
      )}
    </div>

    <div class="entry-meta">
      <span class="date">
        escrito el{" "}
        <strong class="importantshit">{date}</strong>
        {" "}a las{" "}
        <strong class="importantshit">{time}</strong>
      </span>

      <a
        href={`javascript:quote(${ID})`}
        class="post-number reply-link"
      >
        No.{ID}
      </a>
    </div>

  </header>

  <EntryContent message={Message} />
</article>

<style>
  .entry-box {
    box-sizing: border-box;
    margin-top: 20px;
    padding: 10px 15px;

    width: fit-content;
    max-width: 100%;

    border: 1px solid #504945;
    background-color: #282828;
    color: #fbf1c7;

    font-size: 14px;
    line-height: 1.5;
  }

  /* Author and website */

  .entry-author {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .importantshit {
    color: #fbf1c7;
    font-weight: 700;
  }

  .website {
    margin-left: 0.25em;
  }

  /* Header layout */

  .entry-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25em;

    margin-bottom: 5px;
    color: #928374;
  }

  .entry-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75em;
    margin-left: auto;
    min-width: 0;
    max-width: 100%;
  }

  .post-number {
    flex-shrink: 0;
  }

  .date {
    min-width: 0;
    color: #928374;
    overflow-wrap: anywhere;
  }

  /* Entry content */

  .entry-box :global(.entry-content) {
    margin-top: 8px;
    overflow-wrap: break-word;
    font-size: 13px;
  }

  /* Tablet and mobile */

  @media screen and (max-width: 992px) {
    .entry-box {
      width: auto;
      margin-right: 5px;
    }

    .entry-header {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .entry-meta {
      margin-left: 0;
    }
  }

  @media screen and (max-width: 600px) {
    .entry-meta {
      width: 100%;
      gap: 0.5em;
    }

    .date {
      flex-grow: 1;
    }
  }
</style>
