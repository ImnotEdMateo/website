
---
import type { GuestbookEntry } from "@/lib/guestbook/types";
import { normalizeUrl, formatDate } from "@/lib/guestbook/format/";
import EntryContent from "./entryContent.astro";

interface Props {
  entry: GuestbookEntry;
}

const { entry } = Astro.props as Props;
const { ID, CreatedAt, Name, Website, Message } = entry;

const { date, time } = formatDate(CreatedAt);
const safeWebsite = Website ? normalizeUrl(Website) : null;
---

<article class="entry-box" id={`entry-${ID}`}>
  <header class="entry-header">
    <div class="entry-info">
      <span class="entry-author">
        <strong class="importantshit">{Name}</strong>

        {safeWebsite && (
          <span class="website">
            desde{" "}
            <a href={safeWebsite} target="_blank" rel="noopener noreferrer">
              {Website}
            </a>
          </span>
        )}
      </span>

      <span class="date">
        escrito el{" "}
        <strong class="importantshit">{date}</strong>
        a las{" "}
        <strong class="importantshit">{time}</strong>
      </span>
    </div>

    <a
      href={`javascript:quote(${ID})`}
      class="post-number reply-link"
    >
      No.{ID}
    </a>
  </header>

  <EntryContent message={Message} />
</article>

<style>
  .entry-box {
    box-sizing: border-box;
    margin-top: 20px;
    padding: 10px 15px;

    width: fit-content;
    max-width: 100%;

    border: 1px solid #504945;
    background-color: #282828;
    color: #fbf1c7;

    font-size: 14px;
    line-height: 1.5;
  }

  /* Author and website */

  .entry-author {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .importantshit {
    color: #fbf1c7;
    font-weight: 700;
  }

  /* Header layout */
  .entry-header {
    display: flex;
    align-items: baseline;
    gap: 12px;

    margin-bottom: 5px;
    color: #928374;
    min-width: 0;
  }

  .entry-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.35em;
    min-width: 0;
  }

  .entry-author,
  .date {
    overflow-wrap: anywhere;
  }

  .entry-author {
    display: inline;
  }

  .post-number {
    flex-shrink: 0;
    margin-left: auto;
  }

  .importantshit {
    color: #ebdbb2;
  }

  @media screen and (max-width: 992px) {
    .entry-box {
      width: auto;
      margin-right: 5px;
    }

    .entry-header {
      gap: 4px 8px;
    }

    .entry-info {
      flex-direction: column;
      align-items: flex-start;
      column-gap: 0;
    }
  }

  @media screen and (max-width: 600px) {
    .entry-header {
      align-items: baseline;
    }

    .post-number {
      align-self: center;
    }
  }
</style>
